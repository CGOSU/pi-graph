{
  "name": "pi-graph",
  "version": "0.1.0",
  "description": "Incremental symbol graph for focused agent code navigation",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "code-navigation",
    "semantic-graph"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "node scripts/prepare.mjs",
    "benchmark": "npm run build && node dist/scripts/benchmark.js"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.44",
    "@vue/compiler-sfc": "^3.5.44",
    "ignore": "^7.0.5",
    "tree-sitter": "^0.22.4",
    "tree-sitter-rust": "^0.24.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^22.19.0",
    "typebox": "^1.3.0"
  }
}
